# Check if the mesh file exists and download it
import os
mesh_path = "/content/TripoSR/test_output/0/mesh.obj"
mtl_path = "/content/TripoSR/test_output/0/mesh.mtl"
input_img_path = "/content/TripoSR/test_output/0/input.png"
texture_dir = "/content/TripoSR/test_output/0"

print("\n--- Checking for generated files ---\n")

files_to_download = []

if os.path.exists(mesh_path):
    print(f"3D model generated successfully at: {mesh_path}")
    files_to_download.append(mesh_path)
    
    # If material file exists, download that too
    if os.path.exists(mtl_path):
        print(f"Material file found: {mtl_path}")
        files_to_download.append(mtl_path)
    
    # Check for input image
    if os.path.exists(input_img_path):
        print(f"Processed input image found: {input_img_path}")
        files_to_download.append(input_img_path)
    
    # Check for any texture images
    import glob
    textures = glob.glob(f"{texture_dir}/*.png") + glob.glob(f"{texture_dir}/*.jpg")
    for texture in textures:
        if "input.png" not in texture:  # Skip duplicating the input image
            print(f"Texture found: {texture}")
            files_to_download.append(texture)
    
    # Download all files
    print("\n--- Downloading files ---\n")
    from google.colab import files
    for file_path in files_to_download:
        print(f"Initiating download for: {file_path}")
        files.download(file_path)
    
    print("\nAll downloads initiated. Check your browser's download dialog.")
    print("Note: If files don't download automatically, you may need to allow pop-ups in your browser.")
else:
    print("Mesh file not found. Check the logs for errors.")